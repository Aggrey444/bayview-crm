# Database (Railway provides this automatically when you add a PostgreSQL service)
DATABASE_URL="postgresql://user:password@localhost:5432/bayview_crm?schema=public"

# Auth - Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# NextAuth URL - Set to your Railway app URL (e.g., https://your-app.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

# Arkesel SMS Gateway (Ghana - https://arkesel.com)
# Can also be configured directly via Settings > SMS (Arkesel) or Bulk Messages in the UI
ARKESEL_API_KEY="your-arkesel-api-key"
ARKESEL_SENDER_ID="Bayview"
ARKESEL_SANDBOX_MODE="false"
