# Database (Railway provides this automatically when you add a PostgreSQL service)
DATABASE_URL="postgresql://user:password@localhost:5432/bayview_crm?schema=public"

# Auth - Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# NextAuth URL - Set to your Railway app URL (e.g., https://your-app.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"
